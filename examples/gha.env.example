# GFAM GHA/Linux runtime configuration.
# Copy this file to ../.env and fill your current UID/SIGN manually.

# Server: SOP / RO635 / M4A1 / M16 / AR-15 / EN
GFAM_SERVER=SOP

# Required: current account UID and SIGN.
# Do NOT commit your real .env to any public repository.
GFAM_USER_UID=_InputYourUID_
GFAM_SIGN_KEY=_InputYourSIGN_

# Optional: enable fairy auto build/claim/enhance while a foreground module runs.
GFAM_FAIRY_AUTO_ENABLED=0

# Optional: run one module directly when using gfam_gha.py without arguments.
# GFAM_GHA_MODULE=greyzone

# Optional: debug.
GFAM_DEBUG=0
GFAM_SAVE_DEBUG_JSON=0
